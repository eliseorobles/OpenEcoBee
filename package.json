{
  "name": "openecobee-mcp",
  "version": "0.1.0",
  "description": "Control your ecobee through MCP using a local browser sign-in, without a developer API key.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openecobee": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "login": "tsx src/cli.ts login",
    "demo": "tsx src/cli.ts serve --demo",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "check:cloud": "tsc -p tsconfig.worker.json",
    "deploy:dry": "wrangler deploy --dry-run --outdir /tmp/openecobee-worker-build",
    "deploy": "wrangler deploy",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "playwright": "^1.58.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.151.1"
  }
}
